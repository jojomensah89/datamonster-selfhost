{
  "name": "datamonster",
  "version": "0.1.0",
  "private": true,
  "description": "Revenue-first, self-hosted web analytics on Cloudflare Workers + D1. Free to host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jojomensah89/datamonster-selfhost.git"
  },
  "type": "module",
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Password you will use to sign in to your DataMonster dashboard."
      },
      "SESSION_SECRET": {
        "description": "Long random secret string used to sign dashboard session cookies (e.g. 32+ random characters)."
      }
    }
  },
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs",
    "dev": "concurrently -k -n api,web \"wrangler dev --port 8787\" \"vite\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply datamonster --local",
    "db:migrate": "wrangler d1 migrations apply datamonster --remote",
    "deploy": "npm run build && wrangler d1 migrations apply datamonster --remote && wrangler deploy",
    "seed": "node scripts/seed-demo.mjs && wrangler d1 execute datamonster --local --file .wrangler/seed.sql",
    "smoke": "node scripts/smoke.mjs",
    "smoke:agent": "node scripts/smoke-agent.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "2.0.4",
    "react-day-picker": "^10.0.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.152.0"
  }
}
