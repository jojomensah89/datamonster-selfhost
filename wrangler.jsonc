{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datamonster",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Cron (src/cron): hourly, check up to 8 live or in-review launch listings not checked in 20 hours, and drop old per-address event counts.
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    // The home page runs it too, so link previews get this install's own address.
    "run_worker_first": ["/", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datamonster",
      // Replace with the id printed by `npx wrangler d1 create datamonster`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
